# AI Legal Guardian - Backend Configuration
# Copy this file to .env and provide your actual API keys.
# NEVER commit .env to version control or expose API keys to the frontend.

# Google Gemini API Key (100% FREE Tier from https://aistudio.google.com/apikey - no credit card required)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional paid alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Translation API Key (optional - if omitted, OpenAI model or capabilities matrix will handle/indicate)
GOOGLE_TRANSLATION_API_KEY=your_google_translation_api_key_here

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Temporary Session Configuration (In-Memory Processing)
SESSION_TTL_MINUTES=30
MAX_UPLOAD_SIZE_MB=10
